# Bu dosyayı .env olarak kopyala ve değerleri doldur.
# .env dosyası .gitignore'dadır; asla GitHub'a gönderme.

# Yeni anahtar üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=degistir-beni-yeni-bir-anahtar-uret

# Yerelde geliştirirken True, canlı ortamda MUTLAKA False
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://alanadin.com

# Yönetim paneli adresi. Canlıda tahmin edilmesi zor bir şey seç.
DJANGO_ADMIN_URL=yonetim/

# Veritabanı: sqlite (varsayılan) veya postgres
DB_ENGINE=sqlite
# POSTGRES_DB=dert_ortagi
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Canlı ortam için (DJANGO_DEBUG=False iken geçerli)
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_PRELOAD=False
# DJANGO_BEHIND_PROXY=False

# E-posta (parola sıfırlama). Boş bırakılırsa e-postalar konsola yazılır.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=noreply@alanadin.com
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# Moderasyon ve KVKK saklama süreleri (gün)
# AUTO_HIDE_REPORT_THRESHOLD=3
# RETENTION_CLOSED_CONVERSATIONS=90
# RETENTION_RESOLVED_REPORTS=365
# RETENTION_HIDDEN_DERTLER=180
# RETENTION_INACTIVE_ACCOUNTS=730

# Veri sorumlusu (canlıya alınırsa doldur; Aydınlatma Metni'nde görünür)
# DATA_CONTROLLER_NAME=
# DATA_CONTROLLER_ADDRESS=
# DATA_CONTROLLER_CONTACT=
